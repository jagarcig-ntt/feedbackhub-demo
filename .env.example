# Variables que necesita FeedbackHub para funcionar en local.
# Copia este fichero como .env y rellena los valores (.env NO se sube: está en .gitignore).
# En staging y producción estas mismas variables se configuran en Cloudflare Pages,
# con el mismo nombre y distinto valor en cada entorno.

# Entorno: development | staging | production
APP_ENV=development

# Feature flag: campo "valoración de 1 a 5" en la portada (true | false)
FEATURE_VALORACION=true

# Proyecto de Supabase (en local se usa el de staging)
SUPABASE_URL=
SUPABASE_ANON_KEY=
